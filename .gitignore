*.docx
*.docm
*.doc
~$*

# Pandoc / Word / PDF build scratch
/build/
/tmp/
/practical-engineering/build/

# Python environments and caches
.venv/
**/.venv/
__pycache__/
**/__pycache__/
.pytest_cache/
**/.pytest_cache/
.ruff_cache/
**/.ruff_cache/
*.pyc
*.pyo

# Lab simulator output (recreated by make targets)
practical-engineering/labs/**/build/
practical-engineering/labs/**/evidence/
practical-engineering/labs/**/build-output/
practical-engineering/labs/**/dist/
practical-engineering/labs/**/.northwind-infra/

# Local editor and publication helpers — do not publish
.cursor/
/tools/
practical-engineering/tools/
boutique-production/tools/

# Editor and OS
.DS_Store
**/.DS_Store
.vscode/
Thumbs.db
*.log

# Nested lab git must stay local; never publish a renamed .git
**/.git.publish-bak/
