{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "catalog-ownership.schema.json",
  "type": "object",
  "required": ["schema_version", "kind", "id", "ownership"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "catalog-ownership"},
    "id": {"type": "string", "minLength": 1},
    "ownership": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["system", "owner", "escalation", "last_reviewed_at"],
        "properties": {
          "system": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "owner": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "escalation": {"type": "string", "minLength": 1},
          "last_reviewed_at": {"type": "string", "minLength": 1},
          "reported_status": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
