{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quota-showback.schema.json",
  "type": "object",
  "required": ["schema_version", "kind", "id", "pool", "as_of", "entries"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "quota-showback"},
    "id": {"type": "string", "minLength": 1},
    "pool": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "as_of": {"type": "string", "minLength": 1},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["tenant", "unit", "usage", "billed_units", "quality_gate_passed"],
        "properties": {
          "tenant": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "unit": {"type": "string", "minLength": 1},
          "usage": {"type": "integer", "minimum": 0},
          "billed_units": {"type": "integer", "minimum": 0},
          "quality_gate_passed": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
