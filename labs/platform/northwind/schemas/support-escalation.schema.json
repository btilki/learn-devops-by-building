{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "support-escalation.schema.json",
  "type": "object",
  "required": ["schema_version", "kind", "id", "routes"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "support-escalation"},
    "id": {"type": "string", "minLength": 1},
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["system", "kind", "owner", "escalation"],
        "properties": {
          "system": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "kind": {"enum": ["platform-product", "tenant-application"]},
          "owner": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "escalation": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
