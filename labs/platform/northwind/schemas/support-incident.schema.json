{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "support-incident.schema.json",
  "type": "object",
  "required": ["schema_version", "kind", "id", "incidents"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "support-incidents"},
    "id": {"type": "string", "minLength": 1},
    "incidents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "system", "class", "owner", "escalation"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "system": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "class": {"enum": ["platform-product", "tenant-application"]},
          "owner": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "escalation": {"type": "string", "minLength": 1},
          "indicator": {"type": "string", "minLength": 1},
          "closed_reason": {"type": "string", "minLength": 1},
          "recovery_evidence": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "reported_status": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
