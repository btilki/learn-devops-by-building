{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "intake-decision.schema.json",
  "type": "object",
  "required": ["schema_version", "kind", "id", "decisions"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "intake-decisions"},
    "id": {"type": "string", "minLength": 1},
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "candidate",
          "treatment",
          "demand",
          "repetition",
          "isolation_impact",
          "support_cost",
          "owner",
          "review_trigger"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "candidate": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "treatment": {"enum": ["productize", "leave", "decline"]},
          "user_job": {"type": "string"},
          "remaining_owner": {"type": "string"},
          "repetition": {"type": "string", "minLength": 1},
          "isolation_impact": {"type": "string", "minLength": 1},
          "support_cost": {"type": "string", "minLength": 1},
          "demand": {"type": "string"},
          "owner": {"type": "string", "minLength": 1},
          "review_trigger": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
