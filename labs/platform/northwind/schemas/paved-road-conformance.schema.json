{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "paved-road-conformance.schema.json",
  "type": "object",
  "required": ["schema_version", "kind", "id", "entries"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "paved-road-conformance"},
    "id": {"type": "string", "minLength": 1},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["system", "path", "defaults_present"],
        "properties": {
          "system": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "path": {"enum": ["paved", "exited", "unofficial"]},
          "exit": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "defaults_present": {
            "type": "array",
            "items": {"type": "string", "pattern": "^[a-z0-9-]+$"}
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
