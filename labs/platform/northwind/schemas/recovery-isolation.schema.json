{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "recovery-isolation.schema.json",
  "type": "object",
  "required": ["schema_version", "kind", "id", "tenants"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "recovery-isolation"},
    "id": {"type": "string", "minLength": 1},
    "tenants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "tenant",
          "decision",
          "source",
          "replayed_from",
          "mutated_tenants",
          "granted_role",
          "restored_capability",
          "restored_version",
          "quota_units"
        ],
        "properties": {
          "tenant": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "decision": {"enum": ["continue", "freeze"]},
          "source": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "replayed_from": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "mutated_tenants": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "pattern": "^[a-z0-9-]+$"}
          },
          "granted_role": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "restored_capability": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "restored_version": {"type": "string", "minLength": 1},
          "quota_units": {"type": "integer", "minimum": 0}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
