{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fleet-deprecations.schema.json",
  "type": "object",
  "required": ["schema_version", "kind", "id", "deprecations"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "fleet-deprecations"},
    "id": {"type": "string", "minLength": 1},
    "deprecations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "capability", "version", "window_ends_at", "status"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "capability": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "version": {"type": "string", "minLength": 1},
          "window_ends_at": {"type": "string", "minLength": 1},
          "remaining_tenants": {
            "type": "array",
            "items": {"type": "string", "pattern": "^[a-z0-9-]+$"}
          },
          "exception": {"type": "string", "minLength": 1},
          "status": {"enum": ["open", "closed"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
