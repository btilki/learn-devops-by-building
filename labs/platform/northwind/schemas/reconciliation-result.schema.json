{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reconciliation-result.schema.json",
  "type": "object",
  "required": ["schema_version", "kind", "id", "results", "upgrades"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "control-plane-reconciliation"},
    "id": {"type": "string", "minLength": 1},
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "tenant",
          "environment",
          "capability",
          "version",
          "actor",
          "mode",
          "mutated_tenants",
          "source_rewritten",
          "reviewed_intent",
          "immutable_artifact",
          "independent_configuration",
          "reconciliation_result",
          "admission"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "tenant": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "environment": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "capability": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "version": {"type": "string", "minLength": 1},
          "actor": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "mode": {"enum": ["reconcile", "rewrite"]},
          "mutated_tenants": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "pattern": "^[a-z0-9-]+$"}
          },
          "source_rewritten": {"type": "boolean"},
          "reviewed_intent": {"type": "boolean"},
          "immutable_artifact": {"type": "string", "minLength": 1},
          "independent_configuration": {"type": "boolean"},
          "reconciliation_result": {"enum": ["applied", "failed"]},
          "admission": {"enum": ["admitted", "denied"]}
        },
        "additionalProperties": false
      }
    },
    "upgrades": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "from_version",
          "to_version",
          "requested_by",
          "approved_by",
          "result",
          "last_known_good",
          "current_version"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "from_version": {"type": "string", "minLength": 1},
          "to_version": {"type": "string", "minLength": 1},
          "requested_by": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "approved_by": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "result": {"enum": ["failed", "succeeded"]},
          "last_known_good": {"type": "string", "minLength": 1},
          "current_version": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
