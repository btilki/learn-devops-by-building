{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tenancy-roles.schema.json",
  "type": "object",
  "required": ["schema_version", "kind", "id", "roles", "bindings"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "tenancy-roles"},
    "id": {"type": "string", "minLength": 1},
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "scope", "never_inherit"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "scope": {"enum": ["tenant", "control-plane"]},
          "never_inherit": {
            "type": "array",
            "items": {"type": "string", "pattern": "^[a-z0-9-]+$"}
          }
        },
        "additionalProperties": false
      }
    },
    "bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["principal", "role"],
        "properties": {
          "principal": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "tenant": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "role": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "justification": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
