{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "catalog-dependencies.schema.json",
  "type": "object",
  "required": ["schema_version", "kind", "id", "dependencies"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "catalog-dependencies"},
    "id": {"type": "string", "minLength": 1},
    "dependencies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["system", "depends_on"],
        "properties": {
          "system": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "depends_on": {
            "type": "array",
            "items": {"type": "string", "pattern": "^[a-z0-9-]+$"}
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
