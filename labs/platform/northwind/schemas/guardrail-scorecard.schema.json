{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guardrail-scorecard.schema.json",
  "type": "object",
  "required": ["schema_version", "kind", "id", "scorecards"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "guardrail-scorecards"},
    "id": {"type": "string", "minLength": 1},
    "scorecards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["system", "tenant", "path", "defaults_present"],
        "properties": {
          "system": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "tenant": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "path": {"enum": ["paved", "exit"]},
          "exit": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "defaults_present": {
            "type": "array",
            "items": {"type": "string", "pattern": "^[a-z0-9-]+$"}
          },
          "exception": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "reported_status": {"enum": ["green", "red"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
