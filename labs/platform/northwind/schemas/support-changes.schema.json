{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "support-changes.schema.json",
  "type": "object",
  "required": ["schema_version", "kind", "id", "changes"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "support-changes"},
    "id": {"type": "string", "minLength": 1},
    "changes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "resource",
          "subject",
          "approved_by",
          "action",
          "last_known_good",
          "current_version",
          "unofficial",
          "source_rewritten",
          "result"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "resource": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "subject": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "approved_by": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "action": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "granted_role": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "ticket": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "last_known_good": {"type": "string", "minLength": 1},
          "current_version": {"type": "string", "minLength": 1},
          "unofficial": {"type": "boolean"},
          "source_rewritten": {"type": "boolean"},
          "result": {"enum": ["allow", "deny"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
