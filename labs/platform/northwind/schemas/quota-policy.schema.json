{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quota-policy.schema.json",
  "type": "object",
  "required": ["schema_version", "kind", "id", "owner", "pool", "capacity", "tenants"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "quota-policy"},
    "id": {"type": "string", "minLength": 1},
    "owner": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "pool": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "capacity": {"type": "integer", "minimum": 1},
    "tenants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["tenant", "floor", "ceiling"],
        "properties": {
          "tenant": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "floor": {"type": "integer", "minimum": 1},
          "ceiling": {"type": "integer", "minimum": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
