{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "recovery-verification.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "id",
    "plane",
    "restored_snapshot",
    "restored_version",
    "platform_jobs",
    "tenant_decisions",
    "traffic_return",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "recovery-verification"},
    "id": {"type": "string", "minLength": 1},
    "plane": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "restored_snapshot": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "restored_version": {"type": "string", "minLength": 1},
    "status": {"type": "string", "minLength": 1},
    "platform_jobs": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^[a-z0-9-]+$"}
    },
    "tenant_decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["tenant", "decision", "source"],
        "properties": {
          "tenant": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "decision": {"enum": ["continue", "freeze"]},
          "source": {"type": "string", "pattern": "^[a-z0-9-]+$"}
        },
        "additionalProperties": false
      }
    },
    "traffic_return": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["tenant", "evidence"],
        "properties": {
          "tenant": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "evidence": {
            "type": "array",
            "items": {"type": "string", "pattern": "^[a-z0-9_]+$"}
          }
        },
        "additionalProperties": false
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^[a-z0-9-]+$"}
    },
    "recovered_indicators": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[a-z0-9_-]+$"}
    }
  },
  "additionalProperties": false
}
