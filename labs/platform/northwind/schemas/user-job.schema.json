{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "user-job.schema.json",
  "type": "object",
  "required": ["schema_version", "kind", "id", "jobs"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "user-jobs"},
    "id": {"type": "string", "minLength": 1},
    "jobs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "user", "finished_outcome", "owner", "later_proof"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "user": {"type": "string", "minLength": 1},
          "finished_outcome": {"type": "string", "minLength": 1},
          "owner": {"type": "string", "minLength": 1},
          "later_proof": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
