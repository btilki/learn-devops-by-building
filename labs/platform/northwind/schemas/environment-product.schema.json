{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "environment-product.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "id",
    "owner",
    "job",
    "shared_plane",
    "quota_pool",
    "credential_model",
    "forbidden_roles",
    "ttl_hours"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "environment-product"},
    "id": {"type": "string", "minLength": 1},
    "owner": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "job": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "shared_plane": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "quota_pool": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "credential_model": {"type": "string", "minLength": 1},
    "forbidden_roles": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^[a-z0-9-]+$"}
    },
    "ttl_hours": {"type": "integer", "minimum": 1}
  },
  "additionalProperties": false
}
