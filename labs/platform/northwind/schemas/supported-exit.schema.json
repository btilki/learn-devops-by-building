{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "supported-exit.schema.json",
  "type": "object",
  "required": ["schema_version", "kind", "id", "exits"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "supported-exits"},
    "id": {"type": "string", "minLength": 1},
    "exits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "system", "owner", "lost_defaults", "remaining_guardrails", "review_at"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "system": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "owner": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "lost_defaults": {
            "type": "array",
            "items": {"type": "string", "pattern": "^[a-z0-9-]+$"}
          },
          "remaining_guardrails": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "pattern": "^[a-z0-9-]+$"}
          },
          "review_at": {"type": "string", "minLength": 1},
          "reason": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
