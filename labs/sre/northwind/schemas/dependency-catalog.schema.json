{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dependency-catalog.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "id",
    "owner",
    "providers",
    "forbidden_claims"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "dependency-catalog"},
    "id": {"type": "string", "minLength": 1},
    "owner": {"type": "string", "minLength": 1},
    "providers": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["id", "consumer", "kind"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "consumer": {"enum": ["storefront", "fulfillment"]},
          "kind": {"enum": ["external-provider", "supporting-service"]}
        },
        "additionalProperties": false
      }
    },
    "forbidden_claims": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "additionalProperties": false
}
