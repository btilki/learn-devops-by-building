{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "toil-inventory.schema.json",
  "type": "object",
  "required": ["schema_version", "kind", "id", "items"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "toil-inventory"},
    "id": {"type": "string", "minLength": 1},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "class", "kind", "hours_per_week"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "class": {"enum": ["toil", "engineering"]},
          "kind": {"enum": ["interrupt", "project"]},
          "hours_per_week": {"type": "number", "exclusiveMinimum": 0},
          "criticality": {"enum": ["critical", "non-critical"]},
          "rotation": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
