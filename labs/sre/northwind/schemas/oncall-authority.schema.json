{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "oncall-authority.schema.json",
  "type": "object",
  "required": ["schema_version", "kind", "id", "authority"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "oncall-authority"},
    "id": {"type": "string", "minLength": 1},
    "authority": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "system",
          "action",
          "self_approval_forbidden",
          "break_glass"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "system": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "action": {"type": "string", "minLength": 1},
          "self_approval_forbidden": {"const": true},
          "break_glass": {
            "type": "object",
            "required": ["requester", "approver", "expiry", "after_action_review"],
            "properties": {
              "requester": {"type": "string", "minLength": 1},
              "approver": {"type": "string", "minLength": 1},
              "expiry": {"type": "string", "minLength": 1},
              "after_action_review": {"const": true}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
