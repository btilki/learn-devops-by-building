{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "error-budget-exception.schema.json",
  "type": "object",
  "required": ["schema_version", "kind", "id", "exceptions"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "error-budget-exceptions"},
    "id": {"type": "string", "minLength": 1},
    "exceptions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "owner",
          "scope",
          "remaining_journey_risk",
          "expires_at",
          "removal_path"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "owner": {"type": "string", "minLength": 1},
          "scope": {"type": "string", "minLength": 1},
          "remaining_journey_risk": {"type": "string", "minLength": 1},
          "expires_at": {"type": "string", "minLength": 1},
          "removal_path": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
