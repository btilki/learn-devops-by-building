{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sli-method.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "id",
    "owner",
    "treatments",
    "required_fields",
    "forbidden_justifications",
    "allowed_classes"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "sli-method"},
    "id": {"type": "string", "minLength": 1},
    "owner": {"type": "string", "minLength": 1},
    "treatments": {
      "type": "array",
      "minItems": 3,
      "items": {"enum": ["accept", "adjacent", "reject"]}
    },
    "required_fields": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "forbidden_justifications": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "allowed_classes": {
      "type": "array",
      "minItems": 3,
      "items": {
        "enum": ["user-journey-sli", "platform-product-sli", "component-uptime"]
      }
    }
  },
  "additionalProperties": false
}
