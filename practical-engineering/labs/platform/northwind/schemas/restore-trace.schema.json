{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "restore-trace.schema.json",
  "type": "object",
  "required": ["schema_version", "kind", "id", "restores"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "restore-trace"},
    "id": {"type": "string", "minLength": 1},
    "restores": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "snapshot",
          "resource",
          "subject",
          "approved_by",
          "restored_version",
          "last_known_good",
          "mixed_backup",
          "unofficial",
          "source_rewritten",
          "result",
          "roots"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "snapshot": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "resource": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "subject": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "approved_by": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "action": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "granted_role": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "ticket": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "restored_version": {"type": "string", "minLength": 1},
          "last_known_good": {"type": "string", "minLength": 1},
          "mixed_backup": {"type": "boolean"},
          "unofficial": {"type": "boolean"},
          "source_rewritten": {"type": "boolean"},
          "result": {"enum": ["allow", "deny"]},
          "roots": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "pattern": "^[a-z0-9_]+$"}
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
