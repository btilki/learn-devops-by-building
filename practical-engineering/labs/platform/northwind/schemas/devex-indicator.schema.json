{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "devex-indicator.schema.json",
  "type": "object",
  "required": ["schema_version", "kind", "id", "indicators"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "devex-indicators"},
    "id": {"type": "string", "minLength": 1},
    "indicators": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "job", "owner", "class", "evidence_kind"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "job": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "owner": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "class": {"enum": ["platform-product-sli", "portfolio-slo"]},
          "evidence_kind": {"enum": ["leading", "lagging"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
