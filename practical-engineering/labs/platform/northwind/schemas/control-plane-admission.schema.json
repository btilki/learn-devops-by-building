{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "control-plane-admission.schema.json",
  "type": "object",
  "required": ["schema_version", "kind", "id", "admitted_versions", "decisions"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "control-plane-admission"},
    "id": {"type": "string", "minLength": 1},
    "admitted_versions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["capability", "version"],
        "properties": {
          "capability": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "version": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "subject",
          "action",
          "resource",
          "context",
          "policy_identity",
          "result",
          "reason"
        ],
        "properties": {
          "subject": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "action": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "resource": {"type": "string", "minLength": 1},
          "context": {"type": "string", "minLength": 1},
          "policy_identity": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "result": {"enum": ["allow", "deny"]},
          "reason": {"type": "string", "pattern": "^[a-z0-9-]+$"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
