{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fleet-onboarding.schema.json",
  "type": "object",
  "required": ["schema_version", "kind", "id", "owner", "tenants"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "fleet-onboarding"},
    "id": {"type": "string", "minLength": 1},
    "owner": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "tenants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "tenant",
          "system",
          "environment",
          "granted_role",
          "paved_road",
          "quota_floor_respected",
          "status"
        ],
        "properties": {
          "tenant": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "system": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "environment": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "granted_role": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "paved_road": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "quota_floor_respected": {"type": "boolean"},
          "status": {"enum": ["pending", "complete"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
