{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "intake-method.schema.json",
  "type": "object",
  "required": ["schema_version", "kind", "id", "owner", "treatments", "required_fields"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "intake-method"},
    "id": {"type": "string", "minLength": 1},
    "owner": {"type": "string", "minLength": 1},
    "treatments": {
      "type": "array",
      "minItems": 3,
      "items": {"enum": ["productize", "leave", "decline"]}
    },
    "required_fields": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "forbidden_demand": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  },
  "additionalProperties": false
}
