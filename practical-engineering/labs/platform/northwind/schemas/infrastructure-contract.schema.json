{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "infrastructure-contract.schema.json",
  "type": "object",
  "required": ["schema_version", "kind", "id", "versions"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "infrastructure-versions"},
    "id": {"type": "string", "minLength": 1},
    "versions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["capability", "version", "tenant_parameters", "hidden_module"],
        "properties": {
          "capability": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "version": {"type": "string", "minLength": 1},
          "credential_model": {"type": "string"},
          "tenant_parameters": {
            "type": "array",
            "items": {"type": "string", "pattern": "^[a-z0-9-]+$"}
          },
          "hidden_module": {
            "type": "array",
            "items": {"type": "string", "pattern": "^[a-z0-9-]+$"}
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
