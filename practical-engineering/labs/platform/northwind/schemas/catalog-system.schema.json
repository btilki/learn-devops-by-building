{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "catalog-system.schema.json",
  "type": "object",
  "required": ["schema_version", "kind", "id", "systems"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "catalog-systems"},
    "id": {"type": "string", "minLength": 1},
    "systems": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "lifecycle"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "kind": {"enum": ["runnable-service", "platform-product"]},
          "lifecycle": {"enum": ["active", "deprecated"]},
          "tenant": {"type": "string", "pattern": "^[a-z0-9-]+$"}
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {"properties": {"kind": {"const": "runnable-service"}}, "required": ["kind"]},
            "then": {"required": ["tenant"]}
          },
          {
            "if": {"properties": {"kind": {"const": "platform-product"}}, "required": ["kind"]},
            "then": {"not": {"required": ["tenant"]}}
          }
        ]
      }
    }
  },
  "additionalProperties": false
}
