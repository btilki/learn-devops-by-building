{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "control-plane-product.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "id",
    "owner",
    "plane",
    "jobs",
    "credential_model",
    "forbidden_roles",
    "controller_may_rewrite_source",
    "sharing_mode"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "control-plane-product"},
    "id": {"type": "string", "minLength": 1},
    "owner": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "plane": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "jobs": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^[a-z0-9-]+$"}
    },
    "credential_model": {"type": "string", "minLength": 1},
    "forbidden_roles": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[a-z0-9-]+$"}
    },
    "controller_may_rewrite_source": {"type": "boolean"},
    "sharing_mode": {
      "enum": ["shared-control-plane", "shared-nothing", "shared-quota-pool"]
    }
  },
  "additionalProperties": false
}
