{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contract-compatibility.schema.json",
  "type": "object",
  "required": ["schema_version", "kind", "id", "breaking", "allowed_without_bump", "changes"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "contract-compatibility"},
    "id": {"type": "string", "minLength": 1},
    "breaking": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^[a-z0-9-]+$"}
    },
    "allowed_without_bump": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[a-z0-9-]+$"}
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["capability", "version", "kind"],
        "properties": {
          "capability": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "version": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "from_field": {"type": "string"},
          "to_field": {"type": "string"},
          "migration_note": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
