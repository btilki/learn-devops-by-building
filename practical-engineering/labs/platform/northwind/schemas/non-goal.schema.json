{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "non-goal.schema.json",
  "type": "object",
  "required": ["schema_version", "kind", "id", "non_goals"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "platform-non-goals"},
    "id": {"type": "string", "minLength": 1},
    "non_goals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "statement", "remaining_owner"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "statement": {"type": "string", "minLength": 1},
          "remaining_owner": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
