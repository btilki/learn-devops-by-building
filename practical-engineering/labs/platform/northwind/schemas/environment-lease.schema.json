{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "environment-lease.schema.json",
  "type": "object",
  "required": ["schema_version", "kind", "id", "leases"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "environment-leases"},
    "id": {"type": "string", "minLength": 1},
    "leases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "request",
          "tenant",
          "environment",
          "expires_at",
          "quota",
          "credentials",
          "isolation"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "request": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "tenant": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "environment": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "granted_role": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "mutated_by": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "expires_at": {"type": "string", "minLength": 1},
          "reclaimed": {"type": "boolean"},
          "quota": {
            "type": "object",
            "required": ["pool", "units"],
            "properties": {
              "pool": {"type": "string", "pattern": "^[a-z0-9-]+$"},
              "units": {"type": "integer", "minimum": 1}
            },
            "additionalProperties": false
          },
          "credentials": {
            "type": "object",
            "required": ["subject", "issuer", "audience", "expiry", "policy"],
            "properties": {
              "subject": {"type": "string", "minLength": 1},
              "issuer": {"type": "string", "minLength": 1},
              "audience": {"type": "string", "minLength": 1},
              "expiry": {"type": "string", "minLength": 1},
              "policy": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          },
          "isolation": {
            "type": "object",
            "required": ["network", "secrets"],
            "properties": {
              "network": {"type": "string", "pattern": "^[a-z0-9-]+$"},
              "secrets": {"type": "string", "pattern": "^[a-z0-9-]+$"}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
