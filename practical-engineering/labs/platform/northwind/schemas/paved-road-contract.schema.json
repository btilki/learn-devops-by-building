{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "paved-road-contract.schema.json",
  "type": "object",
  "required": ["schema_version", "kind", "id", "owner", "job", "version", "support_level", "steps", "defaults"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "paved-road-contract"},
    "id": {"type": "string", "minLength": 1},
    "owner": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "job": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "version": {"type": "string", "minLength": 1},
    "support_level": {"enum": ["paved"]},
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"}
        },
        "additionalProperties": false
      }
    },
    "defaults": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^[a-z0-9-]+$"}
    }
  },
  "additionalProperties": false
}
