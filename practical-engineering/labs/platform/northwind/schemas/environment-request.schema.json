{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "environment-request.schema.json",
  "type": "object",
  "required": ["schema_version", "kind", "id", "requests"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "environment-requests"},
    "id": {"type": "string", "minLength": 1},
    "requests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "tenant", "environment", "requester", "class", "requested_at"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "tenant": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "environment": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "requester": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "class": {"enum": ["ephemeral", "durable"]},
          "requested_at": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
