{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "error-budget.schema.json",
  "type": "object",
  "required": ["schema_version", "kind", "id", "budgets"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "error-budgets"},
    "id": {"type": "string", "minLength": 1},
    "budgets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "slo", "observation", "owner"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "slo": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "observation": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "owner": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
