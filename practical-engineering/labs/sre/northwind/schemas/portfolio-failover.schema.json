{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "portfolio-failover.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "id",
    "owner",
    "follows",
    "lost",
    "target",
    "when",
    "mode",
    "last_known_good",
    "commander",
    "insufficient_restores",
    "insufficient_identities",
    "insufficient_evidence",
    "review_trigger"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "portfolio-failover"},
    "id": {"type": "string", "minLength": 1},
    "owner": {"type": "string", "minLength": 1},
    "follows": {"const": "northwind-regional-architecture"},
    "lost": {"const": "region-primary"},
    "target": {"const": "region-standby"},
    "when": {"const": "region-primary-lost"},
    "mode": {"const": "active-passive"},
    "last_known_good": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["region", "identity"],
        "properties": {
          "region": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "identity": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "commander": {"type": "string", "minLength": 1},
    "insufficient_restores": {
      "type": "array",
      "minItems": 2,
      "items": {
        "enum": [
          "devops-one-environment-reconstruction",
          "platform-plane-restore"
        ]
      }
    },
    "insufficient_identities": {
      "type": "array",
      "minItems": 2,
      "items": {"type": "string", "minLength": 1}
    },
    "insufficient_evidence": {
      "type": "array",
      "minItems": 2,
      "items": {
        "enum": ["gameday-regional-loss-tabletop", "mixed-backup"]
      }
    },
    "review_trigger": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
