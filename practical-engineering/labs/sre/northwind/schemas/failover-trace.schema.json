{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "failover-trace.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "id",
    "owner",
    "from",
    "to",
    "when",
    "started_at",
    "completed_at",
    "elapsed_seconds",
    "rpo_lost_seconds",
    "lost_isolated"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "failover-trace"},
    "id": {"type": "string", "minLength": 1},
    "owner": {"type": "string", "minLength": 1},
    "from": {"const": "region-primary"},
    "to": {"const": "region-standby"},
    "when": {"const": "region-primary-lost"},
    "started_at": {"type": "string", "minLength": 1},
    "completed_at": {"type": "string", "minLength": 1},
    "elapsed_seconds": {"type": "integer", "minimum": 1},
    "rpo_lost_seconds": {"type": "integer", "minimum": 0},
    "lost_isolated": {"const": true}
  },
  "additionalProperties": false
}
