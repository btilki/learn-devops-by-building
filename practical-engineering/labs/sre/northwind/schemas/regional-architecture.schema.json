{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "regional-architecture.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "id",
    "owner",
    "mode",
    "regions",
    "failover_order"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "regional-architecture"},
    "id": {"type": "string", "minLength": 1},
    "owner": {"type": "string", "minLength": 1},
    "mode": {"const": "active-passive"},
    "regions": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "role"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "role": {"enum": ["primary", "standby"]}
        },
        "additionalProperties": false
      }
    },
    "failover_order": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["from", "to", "when"],
        "properties": {
          "from": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "to": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "when": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
