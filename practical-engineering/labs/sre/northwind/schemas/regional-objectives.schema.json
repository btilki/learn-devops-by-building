{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "regional-objectives.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "id",
    "owner",
    "rto_seconds",
    "rpo_seconds",
    "review_trigger"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "regional-objectives"},
    "id": {"type": "string", "minLength": 1},
    "owner": {"type": "string", "minLength": 1},
    "rto_seconds": {"type": "integer", "exclusiveMinimum": 0},
    "rpo_seconds": {"type": "integer", "exclusiveMinimum": 0},
    "review_trigger": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
