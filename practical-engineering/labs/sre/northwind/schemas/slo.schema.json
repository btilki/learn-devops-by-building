{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "slo.schema.json",
  "type": "object",
  "required": ["schema_version", "kind", "id", "owner", "slos", "non_critical", "legal_products"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "slo-catalog"},
    "id": {"type": "string", "minLength": 1},
    "owner": {"type": "string", "minLength": 1},
    "slos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "journey",
          "sli",
          "window",
          "target",
          "criticality",
          "owner",
          "review_trigger"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "journey": {"type": "string", "minLength": 1},
          "sli": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
          "window": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "target": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
          "criticality": {"enum": ["critical", "supporting"]},
          "owner": {"type": "string", "minLength": 1},
          "review_trigger": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "non_critical": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "reason", "remaining_owner"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1},
          "remaining_owner": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "legal_products": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "status", "reason"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "status": {"const": "out-of-scope"},
          "reason": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
