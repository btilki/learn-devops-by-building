{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "learning-records.schema.json",
  "type": "object",
  "required": ["schema_version", "kind", "id", "records", "waivers"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "learning-records"},
    "id": {"type": "string", "minLength": 1},
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "incident", "owner", "contributing_factors"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "incident": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "owner": {"type": "string", "minLength": 1},
          "contributing_factors": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        },
        "additionalProperties": false
      }
    },
    "waivers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "incident", "owner", "expires_at", "removal_path"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "incident": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "owner": {"type": "string", "minLength": 1},
          "expires_at": {"type": "string", "minLength": 1},
          "removal_path": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
