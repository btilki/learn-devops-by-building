{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "degradation-modes.schema.json",
  "type": "object",
  "required": ["schema_version", "kind", "id", "owner", "modes"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "degradation-modes"},
    "id": {"type": "string", "minLength": 1},
    "owner": {"type": "string", "minLength": 1},
    "modes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "journey",
          "sli",
          "trigger",
          "user_visible",
          "accounting",
          "worker",
          "review_trigger"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "journey": {"type": "string", "minLength": 1},
          "sli": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
          "trigger": {"type": "string", "minLength": 1},
          "user_visible": {"type": "string", "minLength": 1},
          "accounting": {"enum": ["journey-burn"]},
          "worker": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "review_trigger": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
