{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "slo-windows.schema.json",
  "type": "object",
  "required": ["schema_version", "kind", "id", "windows"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "slo-windows"},
    "id": {"type": "string", "minLength": 1},
    "windows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "duration_days", "calendar"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "duration_days": {"type": "integer", "minimum": 1},
          "calendar": {"enum": ["rolling"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
