{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "toil-definition.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "id",
    "owner",
    "classes",
    "kinds",
    "forbidden_measurements"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "toil-definition"},
    "id": {"type": "string", "minLength": 1},
    "owner": {"type": "string", "minLength": 1},
    "classes": {
      "type": "array",
      "minItems": 2,
      "items": {"enum": ["toil", "engineering"]}
    },
    "kinds": {
      "type": "array",
      "minItems": 2,
      "items": {"enum": ["interrupt", "project"]}
    },
    "forbidden_measurements": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "additionalProperties": false
}
