{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "burn-alert.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "id",
    "owner",
    "minimum_evidence_volume",
    "window_pairs",
    "burns"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "burn-alerts"},
    "id": {"type": "string", "minLength": 1},
    "owner": {"type": "string", "minLength": 1},
    "minimum_evidence_volume": {"type": "integer", "minimum": 2},
    "window_pairs": {
      "type": "object",
      "required": ["fast", "slow"],
      "properties": {
        "fast": {
          "type": "object",
          "required": ["short_window", "long_window", "threshold"],
          "properties": {
            "short_window": {"type": "string", "minLength": 1},
            "long_window": {"type": "string", "minLength": 1},
            "threshold": {"type": "number"}
          },
          "additionalProperties": false
        },
        "slow": {
          "type": "object",
          "required": ["short_window", "long_window", "threshold"],
          "properties": {
            "short_window": {"type": "string", "minLength": 1},
            "long_window": {"type": "string", "minLength": 1},
            "threshold": {"type": "number"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "burns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "sli", "class", "disposition", "review_trigger"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "sli": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
          "slo": {"type": "string", "minLength": 1},
          "class": {
            "enum": ["user-journey-sli", "platform-product-sli", "component-uptime"]
          },
          "window_pair": {"enum": ["fast", "slow"]},
          "disposition": {"enum": ["page", "ticket", "record"]},
          "review_trigger": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
