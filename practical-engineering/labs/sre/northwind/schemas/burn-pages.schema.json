{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "burn-pages.schema.json",
  "type": "object",
  "required": ["schema_version", "kind", "id", "pages"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "burn-pages"},
    "id": {"type": "string", "minLength": 1},
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "burn", "destination", "destination_kind"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "burn": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "destination": {"type": "string", "minLength": 1},
          "destination_kind": {"const": "catalog-contact"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
