{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "burn-tickets.schema.json",
  "type": "object",
  "required": ["schema_version", "kind", "id", "tickets"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "burn-tickets"},
    "id": {"type": "string", "minLength": 1},
    "tickets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "burn", "destination"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "burn": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "destination": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
