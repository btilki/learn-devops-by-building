{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "oncall-handoffs.schema.json",
  "type": "object",
  "required": ["schema_version", "kind", "id", "handoffs"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "oncall-handoffs"},
    "id": {"type": "string", "minLength": 1},
    "handoffs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "rotation", "from_primary", "to_primary", "recorded_at"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "rotation": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "from_primary": {"type": "string", "minLength": 1},
          "to_primary": {"type": "string", "minLength": 1},
          "recorded_at": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
