{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reliability-refusal.schema.json",
  "type": "object",
  "required": ["schema_version", "kind", "id", "refusals"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "reliability-refusals"},
    "id": {"type": "string", "minLength": 1},
    "refusals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "statement", "remaining_owner"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "statement": {"type": "string", "minLength": 1},
          "remaining_owner": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
