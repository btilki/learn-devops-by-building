{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sli-decision.schema.json",
  "type": "object",
  "required": ["schema_version", "kind", "id", "decisions"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "sli-decisions"},
    "id": {"type": "string", "minLength": 1},
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "candidate",
          "treatment",
          "class",
          "justification",
          "owner",
          "review_trigger"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "candidate": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
          "treatment": {"enum": ["accept", "adjacent", "reject"]},
          "class": {
            "enum": ["user-journey-sli", "platform-product-sli", "component-uptime"]
          },
          "journey": {"type": "string", "minLength": 1},
          "remaining_owner": {"type": "string", "minLength": 1},
          "justification": {"type": "string", "minLength": 1},
          "owner": {"type": "string", "minLength": 1},
          "review_trigger": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
