{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "attack-path.schema.json",
  "type": "object",
  "required": ["schema_version", "kind", "attack_paths"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "attack-path-register"},
    "attack_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "actor", "capability", "prerequisites", "steps", "threatens", "existing_controls", "missing_evidence", "owner"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "actor": {"type": "string"},
          "capability": {"type": "string"},
          "prerequisites": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["flow", "boundary", "action"],
              "properties": {
                "flow": {"type": "string"},
                "boundary": {"type": "string"},
                "action": {"type": "string"}
              },
              "additionalProperties": false
            }
          },
          "threatens": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "existing_controls": {"type": "array", "items": {"type": "string"}},
          "missing_evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "owner": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
