{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "control.schema.json",
  "type": "object",
  "required": ["schema_version", "kind", "decisions"],
  "properties": {
    "schema_version": {"const": 1}, "kind": {"const": "control-decision-register"},
    "decisions": {"type": "array", "minItems": 1, "items": {
      "type": "object",
      "required": ["id", "risk", "controls", "rationale", "owner", "due_at", "evidence", "review_trigger"],
      "properties": {
        "id": {"type": "string"}, "risk": {"type": "string"},
        "controls": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "type"], "properties": {"id": {"type": "string"}, "type": {"enum": ["prevent", "detect", "respond", "recover"]}}, "additionalProperties": false}},
        "rationale": {"type": "string", "minLength": 1}, "owner": {"type": "string"},
        "due_at": {"type": "string", "format": "date-time"},
        "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "review_trigger": {"type": "string", "minLength": 1}
      }, "additionalProperties": false
    }}
  }, "additionalProperties": false
}
