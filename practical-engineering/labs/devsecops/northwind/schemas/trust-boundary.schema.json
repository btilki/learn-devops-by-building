{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trust-boundary.schema.json",
  "type": "object",
  "required": ["schema_version", "kind", "boundaries"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "trust-boundary-register"},
    "boundaries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "from_zone", "to_zone", "validates", "assumptions", "owner"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "from_zone": {"type": "string"},
          "to_zone": {"type": "string"},
          "validates": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "assumptions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "owner": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
