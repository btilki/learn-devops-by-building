{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "security-invariant.schema.json",
  "type": "object",
  "required": ["schema_version", "kind", "invariants"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "security-invariant-register"},
    "invariants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "statement", "assets", "harms", "owner"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "statement": {"type": "string", "minLength": 1},
          "assets": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "harms": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "owner": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
