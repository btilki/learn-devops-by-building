{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "system-flow.schema.json",
  "type": "object",
  "required": ["schema_version", "kind", "components", "flows"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "system-flow-model"},
    "components": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "type", "owner"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "type": {"enum": ["actor", "service", "data-store", "automation", "external-service"]},
          "owner": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "flows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "from", "to", "carries", "authority", "boundary"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "from": {"type": "string"},
          "to": {"type": "string"},
          "carries": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "authority": {"type": "array", "items": {"type": "string"}},
          "boundary": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
